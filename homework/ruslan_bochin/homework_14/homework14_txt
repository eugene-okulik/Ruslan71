SELECT m.mark, l.name AS lesson_name, s.name AS subject_name
FROM marks m
JOIN lessons l ON m.lesson_id = l.id
JOIN subjects s ON l.subject_id = s.id
WHERE m.student_id = 1;

SELECT b.title
FROM books b
JOIN student_books sb ON b.id = sb.book_id
WHERE sb.student_id = 1;

SELECT st.name AS student_name,
       g.name AS group_name,
       b.title AS book_title,
       m.mark,
       l.name AS lesson_name,
       s.name AS subject_name
FROM students st
LEFT JOIN `groups` g ON st.group_id = g.id
LEFT JOIN student_books sb ON st.id = sb.student_id
LEFT JOIN books b ON sb.book_id = b.id
LEFT JOIN marks m ON st.id = m.student_id
LEFT JOIN lessons l ON m.lesson_id = l.id
LEFT JOIN subjects s ON l.subject_id = s.id
WHERE st.id = 1;
